# Thor 環境変数サンプル。実運用では Cloudera AI Workbench の Secrets に登録する。

# --- Cloudera AI Inference (LLM) ---
CAI_INFERENCE_BASE_URL=
CAI_INFERENCE_API_KEY=
THOR_LLM_ROUTER_MODEL=llama-3-8b-instruct
THOR_LLM_ANALYTICS_MODEL=llama-3-70b-instruct
THOR_LLM_EMBEDDING_MODEL=bge-m3

# --- Trino / CDW ---
TRINO_HOST=
TRINO_PORT=443
TRINO_CATALOG=iceberg
TRINO_SCHEMA=demo

# --- Cloudera Data Visualization ---
CDV_BASE_URL=

# --- S3 / IDBroker ---
IDBROKER_URL=
S3_DEMO_BUCKET=

# --- Knox / Auth ---
KNOX_GATEWAY_URL=

# --- Thor ---
THOR_LOG_LEVEL=INFO
THOR_DEMO_MODE=off
